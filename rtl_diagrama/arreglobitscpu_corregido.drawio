        <mxCell id="OunzQWP6fcX4oq5KIN6V-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=10;" value="Temporización por byte (flancos de CLK):&lt;br&gt;0: fijar DIR_MEM_OUT, RE=0.&lt;br&gt;1 y 2: esperar, RE=0.&lt;br&gt;3: subir RE=1.&lt;br&gt;4: mantener RE=1.&lt;br&gt;5: cargar DATA_C en rcv_data (LD_REG=1).&lt;br&gt;Mantener DIR_MEM_OUT estable de 0 a 5.&lt;br&gt;RE permanece alto hasta la captura; baja en SHIFT.&lt;br&gt;Espera implementada en WAIT1, WAIT2, READ3 y WAIT4 de la FSM." vertex="1">
          <mxGeometry height="280" width="340" x="-1190" y="745" as="geometry" />
        </mxCell>
